{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"tsBuildInfoFile": ".tsbuild/publish.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules", "fixtures", "test"]
}
