{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	"treatConfigHintsAsErrors": true,
	"workspaces": {
		".": {
			"project": ["scripts/**/*.ts"],
			"entry": ["scripts/**/*.test.ts"]
		},
		"packages/*": {},
		"apps/*": {},
		"packages/health-code": {
			"entry": ["src/index.ts", "guest/project.ts", "guest/observe.ts", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "guest/**/*.ts", "test/**/*.ts"]
		}
	}
}
