{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	"treatConfigHintsAsErrors": true,
	"workspaces": {
		".": {
			"project": ["scripts/**/*.ts"],
			"entry": ["scripts/**/*.test.ts"]
		},
		"packages/*": {},
		"apps/*": {},
		"apps/mcp": { "entry": ["cli.ts", "*.test.ts"], "project": ["*.ts"] },
		"packages/health-code": {
			"entry": [
				"src/index.ts",
				"guest/project.ts",
				"guest/observe.ts",
				"guest/agent.ts",
				"guest/managePatch.ts",
				"test/**/*.test.ts"
			],

			// Include dependencies used by the shipped declarations and compiled MCP executable.
			"ignoreDependencies": ["@types/json-schema", "@modelcontextprotocol/server"],
			"project": ["src/**/*.ts", "guest/**/*.ts", "test/**/*.ts"]
		}
	}
}
