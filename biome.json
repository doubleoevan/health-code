{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!.agents",
			"!!.claude",
			"!!.opencode",
			"!!openspec",
			"!skills-lock.json",
			"!!logs",
			"!!**/fixtures/recorded",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error"
			},
			"suspicious": {
				"noImportCycles": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "error"
			},
			"nursery": {
				"useExplicitReturnType": {
					"level": "error",
					"options": {
						"allowExpressions": true
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
